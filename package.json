{
  "name": "dsh-approval-notify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Native approval notifications for DeepSeek Harness",
  "keywords": ["dsh", "deepseek-harness", "plugin", "notification", "approval"],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-approval"]
    }
  }
}
